funcion_limpieza <- function(datos){
  # aplica para segundos
  datos%>%
    filter(HORA!='')%>%
    rowwise()%>%
    # mutate(HORA= as.Date(HORA, format = "%d/%m/%Y"))
    mutate(HORA= as.POSIXct(HORA, 
                            format = "%d/%m/%Y %H:%M:%S", 
                            tz = "America/Caracas"))%>%
    as_tibble()%>%
    mutate(hora= strftime(HORA, format = "%H:%M:%S")) %>%
    distinct()
}

funcion_limpieza2 <- function(datos){
  # aplica para d'ias
  datos%>%
    filter(HORA!='')%>%
    rowwise()%>%
    mutate(HORA= as.Date(HORA, format = "%d/%m/%Y"))%>%
    # mutate(HORA= as.POSIXct(HORA, 
    #                         format = "%d/%m/%Y %H:%M:%S", 
    #                         tz = "America/Caracas"))%>%
    as_tibble()%>%
    mutate(hora= strftime(HORA, format = "%H:%M:%S")) %>%
    distinct()
}

resultados <- lapply(datos,funcion_limpieza )
resultados2 <- lapply(datos,funcion_limpieza2 )


