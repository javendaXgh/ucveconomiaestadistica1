x    <- babies$age[!is.na(babies$age)]

x

result <- hist(x, 
               breaks = 5, 
               plot=F)
library(dplyr)

# fi: frecuencia absoluta
# hi: frecuencia relativa
# Fi: frecuencia absoluta acumulada
# Hi: frecuencia relativa acumulada 


data.frame(mids=result$mids,
           fi=result$counts,
           densidad= result$density)%>%
  mutate(hi= (fi/sum(result$counts)*100))%>%
  mutate(Fi= cumsum(fi))%>%
  mutate(HI= cumsum(fi/sum(result$counts)*100))

