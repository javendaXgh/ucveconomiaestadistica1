library(ggplot2)
library(openintro)
library(dplyr)
library(knitr)

names(ames)
View(head(ames))

ames_subset <- ames%>%
  select(area, price, Kitchen.Qual, MS.SubClass,Overall.Qual, Year.Built,TotRms.AbvGrd)%>%
