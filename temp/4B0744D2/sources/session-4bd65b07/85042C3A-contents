# base taller medidas de tendencia y dispersión
library(WDI)
library(dplyr)

indicador <- 'NY.GDP.DEFL.KD.ZG' #'FP.CPI.TOTL.ZG'

inflacion_cl <- WDI(indicator = indicador, 
                    country = "CL",   
                    # start = 1960,
                    end = 2024) 


inflacion_cl <- inflacion_cl%>%
  janitor::clean_names()%>%
  # filter(between(year, 1961,2023))%>%
  arrange(year)%>%
  mutate(inflacion= round(ny_gdp_defl_kd_zg,1))%>%
  select(4,6)%>%
  filter(!is.na(inflacion))

inflacion_cl2 <- inflacion_cl%>%
  filter(year>1980)
  


write.csv(inflacion_cl,'data/inflacion_chile.csv')
write.csv(inflacion_cl2,'data/inflacion_chile_1980.csv')

inflacion_ven <- WDI(indicator = indicador, 
                    country = "VE",   
                    # start = 1960,
                    end = 2024) 


inflacion_ven <- inflacion_ven%>%
  janitor::clean_names()%>%
  # filter(between(year, 1961,2023))%>%
  arrange(year)%>%
  mutate(inflacion= round(ny_gdp_defl_kd_zg,1))%>%
  select(4,6)%>%
  filter(!is.na(inflacion))

write.csv(inflacion_ven,'data/inflacion_venezuela.csv')

library(tidyverse)
inflacion_binacional <- bind_rows(inflacion_cl%>%
                                    mutate(pais="Chile"),
                                  inflacion_ven%>%
                                    mutate(pais="Venezuela"))%>%
  pivot_wider(names_from = pais,
              values_from = inflacion)
View(inflacion_binacional)

write.csv(inflacion_binacional,'data/inflacion_binacional_wider.csv')

inflacion_binacional1 <- bind_rows(inflacion_cl%>%
                                    mutate(pais="Chile"),
                                  inflacion_ven%>%
                                    mutate(pais="Venezuela"))

write.csv(inflacion_binacional1,'data/inflacion_binacional_longer.csv')

